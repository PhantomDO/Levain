{
  "name": "levain",
  "version": "0.1.0",
  "description": "Moteur de jeu 3D en C++23 sur NVRHI et flecs",
  "homepage": "https://github.com/PhantomDO/Levain",
  "license": "MIT",
  "builtin-baseline": "9e593bb18ea69cc5095e012465dcd675a822ed0d",
  "dependencies": [
    "doctest",
    {
      "name": "directx-dxc",
      "host": true
    },
    "flecs",
    {
      "name": "dawn",
      "default-features": false,
      "features": [
        {
          "name": "vulkan",
          "platform": "!emscripten"
        }
      ]
    },
    "fastgltf",
    "glm",
    {
      "name": "imgui",
      "features": [
        "docking-experimental"
      ]
    },
    "joltphysics",
    "ktx",
    "meshoptimizer",
    "nvrhi",
    "ozz-animation",
    {
      "name": "shader-slang",
      "host": true
    },
    {
      "name": "sdl3",
      "default-features": false,
      "features": [
        {
          "name": "vulkan",
          "platform": "!emscripten"
        },
        {
          "name": "wayland",
          "platform": "linux"
        },
        {
          "name": "x11",
          "platform": "linux"
        }
      ]
    },
    "spdlog",
    "stb",
    {
      "name": "tracy",
      "platform": "!emscripten"
    },
    {
      "name": "vk-bootstrap",
      "platform": "!emscripten"
    },
    {
      "name": "vulkan-validationlayers",
      "platform": "windows"
    }
  ],
  "vcpkg-configuration": {
    "overlay-ports": [
      "./ports"
    ],
    "overlay-triplets": [
      "./triplets"
    ]
  }
}
